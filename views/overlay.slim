meta http-equiv="refresh" content="5"
.container
  .columns.col-gapless
    .column.col-1
      .column.col-12.attacker.dosis-bold.centered
        | Attacker
        .column.col-12
          = game_state[:player1][:role] == 'Attacker' ? game_state[:player1][:name] : game_state[:player2][:name]
        .column.col-12
          = game_state[:player1][:role] == 'Attacker' ? game_state[:player1][:army] : game_state[:player2][:army]
        .column.col-12
          = game_state[:player1][:role] == 'Attacker' ? game_state[:player1][:detachment] : game_state[:player2][:detachment]
        .columns.vpcp
          .column.col-6 VP
          .column.col-6 CP
        .columns.vpcp
          .column.col-6
            = game_state[:player1][:role] == 'Attacker' ? game_state[:player1][:primary] + game_state[:player1][:secondary] : game_state[:player2][:primary] + game_state[:player2][:secondary]
          .column.col-6
            = game_state[:player1][:role] == 'Attacker' ? game_state[:player1][:cp] : game_state[:player2][:cp]
        img.faction src="images/#{(game_state[:player1][:role] == 'Attacker' ? game_state[:player1][:army] : game_state[:player2][:army]).downcase.gsub(' ', '-')}.png"

      .column.col-12.camera
        | Camera

      .column.col-12.defender.dosis-bold.centered
        | Defender
        .column.col-12
          = game_state[:player1][:role] == 'Defender' ? game_state[:player1][:name] : game_state[:player2][:name]
        .column.col-12
          = game_state[:player1][:role] == 'Defender' ? game_state[:player1][:army] : game_state[:player2][:army]
        .column.col-12
          = game_state[:player1][:role] == 'Defender' ? game_state[:player1][:detachment] : game_state[:player2][:detachment]
        .columns.vpcp
          .column.col-6 VP
          .column.col-6 CP
        .columns.vpcp
          .column.col-6
            = game_state[:player1][:role] == 'Defender' ? game_state[:player1][:primary] + game_state[:player1][:secondary] : game_state[:player2][:primary] + game_state[:player2][:secondary]
          .column.col-6
            = game_state[:player1][:role] == 'Defender' ? game_state[:player1][:cp] : game_state[:player2][:cp]
        img.faction src="images/#{(game_state[:player1][:role] == 'Defender' ? game_state[:player1][:army] : game_state[:player2][:army]).downcase.gsub(' ', '-')}.png"

    .column.col-11.main_area
      .column.col-12.main_camera
        - if game_state[:turn] > 5
          .game-over.text-center
            h1.text-light Game Over
            h2.text-light Winner:
            h1.text-light.large
              - if game_state[:winner]
                = game_state[:winner]
              - else
                | Draw
        - else
          | Main Camera

      - unless game_state[:turn] > 5
        .column.col-12.supporter
          .columns.col-oneline
            - turn_class = game_state[:phase] == "Top" ? "turn-atk" : "turn-def"
            - up_arrow_color = game_state[:phase] == "Top" ? "white" : "black"
            - down_arrow_color = game_state[:phase] == "Bottom" ? "white" : "black"

            .column.col-1.turn-status.centered class=turn_class
              .columns.col-oneline
                .column.col-6
                  i.fas.fa-arrow-up[style="color: #{up_arrow_color}; font-size: 1.5em;"]
                .column.col-6
                  i.fas.fa-arrow-down[style="color: #{down_arrow_color}; font-size: 1.5em;"]

            .column.col-2.dosis-bold
              | Turn #{game_state[:turn]}

            .column.col-9.dosis-bold
              | Latest Twitch Notification Somehow:
