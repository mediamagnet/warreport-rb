.container
  .columns.col-gapless
    .column.col-1
      .column.col-12.attacker.dosis-bold.centered
        | Attacker
        .column.col-12#attacker-name
          = game_state[:player1][:name] if game_state[:player1][:role] == 'Attacker'
          = game_state[:player2][:name] if game_state[:player2][:role] == 'Attacker'
        .column.col-12#attacker-army
          = game_state[:player1][:army] if game_state[:player1][:role] == 'Attacker'
          = game_state[:player2][:army] if game_state[:player2][:role] == 'Attacker'
        .column.col-12#attacker-detachment
          = game_state[:player1][:detachment] if game_state[:player1][:role] == 'Attacker'
          = game_state[:player2][:detachment] if game_state[:player2][:role] == 'Attacker'

        .columns.vpcp
          .column.col-6 VP
          .column.col-6 CP
        .columns.vpcp
          .column.col-6#attacker-vp
            = game_state[:player1][:primary] + game_state[:player1][:secondary] if game_state[:player1][:role] == 'Attacker'
            = game_state[:player2][:primary] + game_state[:player2][:secondary] if game_state[:player2][:role] == 'Attacker'
          .column.col-6#attacker-cp
            = game_state[:player1][:cp] if game_state[:player1][:role] == 'Attacker'
            = game_state[:player2][:cp] if game_state[:player2][:role] == 'Attacker'

        .column.col-12#attacker-icon
          - if game_state[:player1][:role] == 'Attacker'
            img.faction src="images/#{game_state[:player1][:army].downcase.gsub(' ', '-').gsub('_','-').gsub('\'','')}.png"
          - if game_state[:player2][:role] == 'Attacker'
            img.faction src="images/#{game_state[:player2][:army].downcase.gsub(' ', '-').gsub('_','-').gsub('\'','')}.png"

      .column.col-12.camera
        | Camera

      .column.col-12.defender.dosis-bold.centered
        | Defender
        .column.col-12#defender-name
          = game_state[:player1][:name] if game_state[:player1][:role] == 'Defender'
          = game_state[:player2][:name] if game_state[:player2][:role] == 'Defender'
        .column.col-12#defender-army
          = game_state[:player1][:army] if game_state[:player1][:role] == 'Defender'
          = game_state[:player2][:army] if game_state[:player2][:role] == 'Defender'
        .column.col-12#defender-detachment
          = game_state[:player1][:detachment] if game_state[:player1][:role] == 'Defender'
          = game_state[:player2][:detachment] if game_state[:player2][:role] == 'Defender'

        .columns.vpcp
          .column.col-6 VP
          .column.col-6 CP
        .columns.vpcp
          .column.col-6#defender-vp
            = game_state[:player1][:primary] + game_state[:player1][:secondary] if game_state[:player1][:role] == 'Defender'
            = game_state[:player2][:primary] + game_state[:player2][:secondary] if game_state[:player2][:role] == 'Defender'
          .column.col-6#defender-cp
            = game_state[:player1][:cp] if game_state[:player1][:role] == 'Defender'
            = game_state[:player2][:cp] if game_state[:player2][:role] == 'Defender'

        .column.col-12#defender-icon
          - if game_state[:player1][:role] == 'Defender'
            img.faction src="images/#{game_state[:player1][:army].downcase.gsub(' ', '-').gsub('_','-').gsub('\'','')}.png"
          - if game_state[:player2][:role] == 'Defender'
            img.faction src="images/#{game_state[:player2][:army].downcase.gsub(' ', '-').gsub('_','-').gsub('\'','')}.png"

    .column.col-11.main_area
      .column.col-12.main_camera
        - if game_state[:game_over] && game_state[:winner] && !game_state[:winner].empty?
          .winner-overlay
            h1.text-light.large.centered = "#{game_state[:winner]} Wins!"
        | Main Camera

      .column.col-12.supporter
        .columns.col-oneline
          - turn_class = game_state[:phase] == "Top" ? "turn-atk" : "turn-def"
          .column.col-1 class=turn_class
            .columns.col-oneline
              .column.col-5.turn-status.centered
                i.fa-solid.fa-arrow-up[style="color: #{game_state[:phase] == 'Top' ? 'white' : 'black'};"]
              .column.col-5.turn-status.centered
                i.fa-solid.fa-arrow-down[style="color: #{game_state[:phase] == 'Bottom' ? 'white' : 'black'};"]

          .column.col-2.dosis-bold.text-dark#turn-counter
            | Turn #{game_state[:turn]}

          .column.col-9.dosis-bold.text-dark#mission-info
            - if game_state[:mission_rule]
              | Mission Rule: #{game_state[:mission_rule]} | 
            - if game_state[:primary_mission]
              | Primary Mission: #{game_state[:primary_mission]}
            - else
              | No Mission Rule Selected

.deployment-container-floating
  - if game_state[:deployment] && !game_state[:deployment].empty?
    img#deployment-map.deployment-map src="/images/deployments/PN_#{game_state[:deployment]}.png" alt="Deployment Map"
