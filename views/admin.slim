h1 Admin Panel

form
  h2 Player 1
  label for="player1_name" Name:
  input#player1_name.admin-input type="text" data-player="Player 1" data-field="name" value=game_state[:player1][:name]

  label for="player1_role" Role:
  select#player1_role.admin-input data-player="Player 1" data-field="role"
    - ["Attacker", "Defender"].each do |role|
      option value=role selected=(game_state[:player1][:role] == role) = role

  label for="player1_army" Army:
  select#player1_army.admin-input data-player="Player 1" data-field="army"
    - FACTIONS.values.flatten.each do |faction|
      option value=faction selected=(game_state[:player1][:army] == faction) = faction

  label for="player1_detachment" Detachment:
  input#player1_detachment.admin-input type="text" data-player="Player 1" data-field="detachment" value=game_state[:player1][:detachment]

  h2 Player 2
  label for="player2_name" Name:
  input#player2_name.admin-input type="text" data-player="Player 2" data-field="name" value=game_state[:player2][:name]

  label for="player2_role" Role:
  select#player2_role.admin-input data-player="Player 2" data-field="role"
    - ["Attacker", "Defender"].each do |role|
      option value=role selected=(game_state[:player2][:role] == role) = role

  label for="player2_army" Army:
  select#player2_army.admin-input data-player="Player 2" data-field="army"
    - FACTIONS.values.flatten.each do |faction|
      option value=faction selected=(game_state[:player2][:army] == faction) = faction

  label for="player2_detachment" Detachment:
  input#player2_detachment.admin-input type="text" data-player="Player 2" data-field="detachment" value=game_state[:player2][:detachment]

  h2 Deployment
  select#deployment-select.admin-input data-field="deployment"
    option value="" Select a Deployment
    - Dir.glob("public/images/deployments/*.png").each do |file|
      - filename = File.basename(file, ".png").gsub("PN_", "")
      option value=filename selected=(game_state[:deployment] == filename) = filename

  h2 Mission Rule
  select#mission-rule-select.admin-input data-field="mission_rule"
    option value="" Select a Mission Rule
    - mission_rules.each do |rule_name, description|
      option value=rule_name selected=(game_state[:mission_rule] == rule_name) = rule_name

  h2 Primary Mission
  select#primary-mission-select.admin-input data-field="primary_mission"
    option value="" Select a Primary Mission
    - primary_missions.each do |mission_name, description|
      option value=mission_name selected=(game_state[:primary_mission] == mission_name) = mission_name

  h2 Game Control
  button#reset-game Reset Game
  button#end-game End Game
