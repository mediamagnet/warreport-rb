/! meta http-equiv="refresh" content="5"

.container
  .columns.col-gapless
    .column.col-1
      .column.col-12.attacker.dosis-bold.centered
        | Attacker
        .column.col-12
          | #{game_state[:player1][:name]}
        .column.col-12
          | #{game_state[:player1][:army]}
        .column.col-12
          | #{game_state[:player1][:detachment]}
        .columns.vpcp
          .column.col-6
            | VP
          .column.col-6
            | CP
        .columns.vpcp
          .column.col-6
            | #{game_state[:player1][:primary] + game_state[:player1][:secondary]}
          .column.col-6
            | #{game_state[:player1][:cp]}
        img.faction[src="images/#{game_state[:player1][:army].downcase.gsub(' ', '_')}.png"]
      .column.col-12.camera
        | Camera
      .column.col-12.defender.dosis-bold.centered
        | Defender
        .column.col-12
          | #{game_state[:player2][:name]}
        .column.col-12
          | #{game_state[:player2][:army]}
        .column.col-12
          | #{game_state[:player2][:detachment]}
        .columns.vpcp
          .column.col-6
            | VP
          .column.col-6
            | CP
        .columns.vpcp
          .column.col-6
            | #{game_state[:player2][:primary] + game_state[:player2][:secondary]}
          .column.col-6
            | #{game_state[:player2][:cp]}
        img.faction[src="images/#{game_state[:player2][:army].downcase.gsub(' ', '_')}.png"]
    .column.col-11.main_area
      .column.col-12.main_camera
        | Main Camera
      .column.col-12.supporter
        .columns.col-oneline
          .column.col-1 class=(game_state[:phase] == 'Top' ? 'turn-atk' : 'turn-def')
            .columns.col-oneline
              .column.col-5.turn-status.centered
                i class=(game_state[:phase] == 'Top' ? 'fa-solid fa-arrow-up' : 'fa-solid fa-arrow-down') style="color:white; font-size: 2em;"
              .column.col-5.turn-status.centered
                i class="fa-solid fa-arrow-down" style="color:black; font-size: 2em;"
          .column.col-2.dosis-bold.turn-text.centered
            | Turn #{game_state[:turn]}
          .column.col-9.dosis-bold
            | Latest Twitch Notification Somehow:
